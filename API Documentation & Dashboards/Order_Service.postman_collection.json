            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Health - readiness (includes DB)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{mgmtUrl}}/actuator/health/readiness",
              "host": [
                "{{mgmtUrl}}"
              ],
              "path": [
                "actuator",
                "health",
                "readiness"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{mgmtUrl}}/actuator/info",
              "host": [
                "{{mgmtUrl}}"
              ],
              "path": [
                "actuator",
                "info"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Prometheus metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{mgmtUrl}}/actuator/prometheus",
              "host": [
                "{{mgmtUrl}}"
              ],
              "path": [
                "actuator",
                "prometheus"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('has HTTP server metrics', () => pm.expect(pm.response.text()).to.include('http_server_requests_seconds_count'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actuator on public port (should be 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 - not exposed on 8080', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}